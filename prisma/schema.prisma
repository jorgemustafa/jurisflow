generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id          String           @id @default(uuid())
  type        ClientType
  status      ClientStatus     @default(ACTIVE)
  name        String
  document    String?          @unique @db.VarChar(14)
  rg          String?          @db.VarChar(20)
  email       String?
  phone       String?          @db.VarChar(11)
  address     String?
  street      String?
  city        String?          @db.VarChar(120)
  state       String?          @db.VarChar(2)
  zipCode     String?          @db.VarChar(8)
  notes       String?
  cases       Case[]
  payments    Payment[]
  documents   Document[]
  importItems CaseImportItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([type])
  @@index([status, type])
}

model User {
  id                String              @id @default(uuid())
  name              String
  email             String              @unique
  passwordHash      String?
  role              UserRole            @default(LAWYER)
  status            UserStatus          @default(ACTIVE)
  oabNumber         String?             @db.VarChar(20)
  oabState          String?             @db.VarChar(2)
  cases             Case[]
  timelineEvents    CaseTimelineEvent[]
  syncRunsTriggered CaseSyncRun[]
  notifications     Notification[]
  documentsUploaded Document[]          @relation("DocumentUploader")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Case {
  id                  String              @id @default(uuid())
  clientId            String
  responsibleUserId   String?
  caseType            CaseType            @default(JUDICIAL)
  title               String
  cnjNumber           String?             @unique
  status              CaseStatus          @default(ACTIVE)
  stage               CaseStage?
  legalArea           LegalArea?
  opposingParty       String?
  court               String?
  jurisdiction        String?
  division            String?
  description         String?
  openedAt            DateTime?
  closedAt            DateTime?
  totalFeeAmountCents Int
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  responsibleUser     User?               @relation(fields: [responsibleUserId], references: [id])
  payments            Payment[]
  documents           Document[]
  timelineEvents      CaseTimelineEvent[]
  deadlines           CaseDeadline[]
  syncRuns            CaseSyncRun[]
  notifications       Notification[]
  lastSyncedAt        DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([clientId])
  @@index([responsibleUserId])
  @@index([status])
  @@index([caseType])
  @@index([stage])
  @@index([legalArea])
}

model Payment {
  id                String         @id @default(uuid())
  clientId          String
  caseId            String?
  paymentScheduleId String?
  source            PaymentSource  @default(MANUAL)
  description       String
  amountCents       Int
  dueDate           DateTime
  paidAt            DateTime?
  paymentMethod     PaymentMethod?
  status            PaymentStatus  @default(PENDING)
  installmentNumber Int            @default(1)
  installmentTotal  Int            @default(1)
  notes             String?
  canceledAt        DateTime?
  cancelReason      String?
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case              Case?          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([clientId])
  @@index([caseId])
  @@index([paymentScheduleId])
  @@index([status])
  @@index([dueDate])
  @@index([paidAt])
}

model Document {
  id               String    @id @default(uuid())
  clientId         String
  caseId           String?
  uploadedByUserId String?
  name             String
  originalName     String
  storageKey       String    @unique
  mimeType         String
  sizeBytes        Int
  checksumSha256   String    @db.VarChar(64)
  deletedAt        DateTime?
  purgeAfter       DateTime?
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  case             Case?     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedByUser   User?     @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clientId])
  @@index([caseId])
  @@index([mimeType])
  @@index([deletedAt])
  @@index([purgeAfter])
  @@index([uploadedByUserId])
}

model CaseDeadline {
  id          String             @id @default(uuid())
  caseId      String
  title       String
  description String?
  dueAt       DateTime
  status      CaseDeadlineStatus @default(PENDING)
  completedAt DateTime?
  case        Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([caseId, dueAt])
  @@index([status, dueAt])
}

model CaseTimelineEvent {
  id              String                @id @default(uuid())
  caseId          String
  createdByUserId String?
  externalSource  String?
  externalId      String?
  sourceHash      String?
  type            CaseTimelineEventType
  title           String
  description     String?
  occurredAt      DateTime
  case            Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdByUser   User?                 @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([caseId, sourceHash])
  @@index([caseId, occurredAt])
  @@index([createdByUserId])
  @@index([externalSource])
  @@index([type])
}

model CaseImportBatch {
  id        String                @id @default(uuid())
  status    CaseImportBatchStatus @default(OPEN)
  source    String                @default("datajud")
  items     CaseImportItem[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, createdAt])
}

model CaseImportItem {
  id           String               @id @default(uuid())
  batchId      String
  cnjNumber    String               @db.VarChar(20)
  courtCode    String?
  status       CaseImportItemStatus @default(PENDING)
  errorMessage String?
  draft        Json?
  financeData  Json?
  clientId     String?
  caseId       String?
  batch        CaseImportBatch      @relation(fields: [batchId], references: [id])
  client       Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([batchId])
  @@index([status])
  @@index([cnjNumber])
  @@index([clientId])
}

model CaseSyncRun {
  id                String          @id @default(uuid())
  caseId            String
  triggeredByUserId String?
  trigger           CaseSyncTrigger
  status            CaseSyncStatus
  newMovements      Int             @default(0)
  errorMessage      String?
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  triggeredByUser   User?           @relation(fields: [triggeredByUserId], references: [id])

  @@index([caseId, startedAt])
  @@index([trigger, startedAt])
}

model Notification {
  id           String    @id @default(uuid())
  userId       String
  caseId       String
  title        String
  body         String?
  newMovements Int       @default(0)
  readAt       DateTime?
  user         User      @relation(fields: [userId], references: [id])
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([caseId])
}

enum CaseSyncTrigger {
  MANUAL
  SCHEDULED
}

enum CaseSyncStatus {
  SUCCESS
  NO_CHANGES
  FAILED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  LAWYER
  ASSISTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CaseType {
  JUDICIAL
  EXTRAJUDICIAL
}

enum CaseStatus {
  ACTIVE
  ON_HOLD
  CLOSED
  CANCELED
}

enum CaseStage {
  INITIAL
  HEARING_SCHEDULED
  WAITING_DECISION
  APPEAL
  ENFORCEMENT
}

enum LegalArea {
  CIVIL
  LABOR
  FAMILY
  CRIMINAL
  TAX
  CONSUMER
  BUSINESS
  SOCIAL_SECURITY
  OTHER
}

enum PaymentSource {
  GENERATED
  MANUAL
}

enum PaymentMethod {
  PIX
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

enum CaseDeadlineStatus {
  PENDING
  DONE
  CANCELED
}

enum CaseTimelineEventType {
  NOTE
  HEARING
  PETITION
  DECISION
  STATUS_CHANGE
  OTHER
}

enum CaseImportBatchStatus {
  OPEN
  COMPLETED
}

enum CaseImportItemStatus {
  PENDING
  DUPLICATE
  FAILED
  IMPORTED
  DISCARDED
}
