{
  "name": "jurisflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "docker:down": "docker compose down",
    "docker:migrate": "docker compose exec -T api npx prisma migrate deploy",
    "docker:seed": "docker compose exec -T api npx tsx scripts/seed-demo-data.ts",
    "docker:up": "docker compose up --build",
    "prod:env:check": "node scripts/validate-production-env.mjs .env.prod",
    "prod:config": "npm run prod:env:check && docker compose --env-file .env.prod -f compose.prod.yml config",
    "prod:up": "npm run prod:env:check && docker compose --env-file .env.prod -f compose.prod.yml up -d --build",
    "prod:down": "docker compose --env-file .env.prod -f compose.prod.yml down",
    "dev:api": "npm run dev -w @jurisflow/api",
    "dev:web": "npm run dev -w @jurisflow/web",
    "format": "prettier --write .",
    "lint": "eslint .",
    "pretest": "npm run build -w @jurisflow/shared",
    "pretypecheck": "npm run build -w @jurisflow/shared",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio --port 5555",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "seed:notifications": "tsx scripts/seed-notifications.ts",
    "user:create": "tsx scripts/create-user.ts",
    "test": "npm run test:prod-env && npm run test --workspaces --if-present",
    "test:prod-env": "vitest run scripts/validate-production-env.test.js --environment node --globals",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.4.2",
    "prisma": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
